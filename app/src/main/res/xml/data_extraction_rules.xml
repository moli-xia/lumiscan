<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: a restored or transferred copy of the app must sign in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
